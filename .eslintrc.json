{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-debugger": "error"
  },
  "globals": {
    "bootstrap": "readonly",
    "firebase": "readonly",
    "document": "readonly",
    "window": "readonly",
    "console": "readonly",
    "alert": "readonly"
  }
}
